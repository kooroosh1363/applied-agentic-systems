{"name":"02 - Delivery Retry and DLQ","nodes":[{"parameters":{"rule":{"interval":[{"field":"minutes","minutesInterval":1}]}},"id":"timer","name":"Every Minute","type":"n8n-nodes-base.scheduleTrigger","typeVersion":1.2,"position":[-360,0]},{"parameters":{"operation":"executeQuery","query":"SELECT a.id,a.ticket_id,a.draft_id,a.attempt_number,d.content,t.customer_id AS destination,t.idempotency_key FROM delivery_attempts a JOIN reply_drafts d ON d.id=a.draft_id JOIN tickets t ON t.id=a.ticket_id WHERE a.status='pending' AND a.next_retry_at<=now() ORDER BY a.next_retry_at FOR UPDATE SKIP LOCKED LIMIT 25;"},"id":"load","name":"Load Due Attempts","type":"n8n-nodes-base.postgres","typeVersion":2.5,"position":[-120,0],"credentials":{"postgres":{"id":"LOCAL_POSTGRES_CREDENTIAL","name":"Local Support Postgres"}}},{"parameters":{"method":"POST","url":"={{$env.SUPPORT_ENGINE_URL + '/v1/deliver'}}","sendBody":true,"contentType":"raw","rawContentType":"application/json","body":"={{JSON.stringify({idempotencyKey:$json.idempotency_key,destination:$json.destination,message:$json.content})}}","options":{"response":{"response":{"neverError":true,"fullResponse":true}}}},"id":"deliver","name":"Deliver via Local Adapter","type":"n8n-nodes-base.httpRequest","typeVersion":4.2,"position":[120,0]},{"parameters":{"jsCode":"const original=$('Load Due Attempts').item.json,status=$json.statusCode??500;const outcome=status>=200&&status<300?'delivered':(status===429||status>=500)?(original.attempt_number>=3?'dlq':'retry'):'dlq';return[{json:{...original,httpStatus:status,outcome,nextAttempt:original.attempt_number+1,backoffSeconds:Math.min(300,2**original.attempt_number)}}];"},"id":"classify","name":"Classify Delivery Result","type":"n8n-nodes-base.code","typeVersion":2,"position":[360,0]},{"parameters":{"operation":"executeQuery","query":"UPDATE delivery_attempts SET status=CASE WHEN $1='delivered' THEN 'delivered' WHEN $1='retry' THEN 'retrying' ELSE 'dlq' END,error_code=$2 WHERE id=$3; INSERT INTO delivery_attempts(ticket_id,draft_id,attempt_number,status,provider,next_retry_at) SELECT $4,$5,$6,'pending','local-mock',now()+make_interval(secs=>$7) WHERE $1='retry' ON CONFLICT DO NOTHING; INSERT INTO dead_letter_events(ticket_id,reason,payload) SELECT $4,'delivery_exhausted',jsonb_build_object('httpStatus',$2) WHERE $1='dlq';" ,"options":{"queryReplacement":"={{[$json.outcome,String($json.httpStatus),$json.id,$json.ticket_id,$json.draft_id,$json.nextAttempt,$json.backoffSeconds]}}"}},"id":"persist","name":"Persist Outcome Retry or DLQ","type":"n8n-nodes-base.postgres","typeVersion":2.5,"position":[600,0],"credentials":{"postgres":{"id":"LOCAL_POSTGRES_CREDENTIAL","name":"Local Support Postgres"}}}],"connections":{"Every Minute":{"main":[[{"node":"Load Due Attempts","type":"main","index":0}]]},"Load Due Attempts":{"main":[[{"node":"Deliver via Local Adapter","type":"main","index":0}]]},"Deliver via Local Adapter":{"main":[[{"node":"Classify Delivery Result","type":"main","index":0}]]},"Classify Delivery Result":{"main":[[{"node":"Persist Outcome Retry or DLQ","type":"main","index":0}]]}},"settings":{"executionOrder":"v1","saveDataErrorExecution":"all"},"active":false,"tags":[]}
