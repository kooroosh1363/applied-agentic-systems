{"name":"02 - Support Approval Action","nodes":[{"parameters":{"httpMethod":"POST","path":"support-approval","responseMode":"responseNode"},"id":"approval-webhook","name":"Approval Webhook","type":"n8n-nodes-base.webhook","typeVersion":2,"position":[-360,0]},{"parameters":{"jsCode":"const b=$json.body??$json;const action=String(b.action??'');if(!b.draftId||!b.reviewer||!['approved','rejected'].includes(action))throw new Error('invalid approval');return[{json:{draftId:b.draftId,reviewer:b.reviewer,action}}];"},"id":"validate","name":"Validate Human Decision","type":"n8n-nodes-base.code","typeVersion":2,"position":[-120,0]},{"parameters":{"operation":"executeQuery","query":"WITH d AS (UPDATE reply_drafts SET status=$1,reviewer=$2,reviewed_at=now() WHERE id=$3 AND status='pending' RETURNING id,ticket_id), a AS (INSERT INTO audit_log(ticket_id,actor,action,evidence_type) SELECT ticket_id,$2,$1,'provider_verified' FROM d) INSERT INTO delivery_attempts(ticket_id,draft_id,attempt_number,status,provider,next_retry_at) SELECT ticket_id,id,1,'pending','local-mock',now() FROM d WHERE $1='approved' ON CONFLICT DO NOTHING RETURNING id;","options":{"queryReplacement":"={{[$json.action,$json.reviewer,$json.draftId]}}"}},"id":"record","name":"Record Approval & Queue","type":"n8n-nodes-base.postgres","typeVersion":2.5,"position":[120,0],"credentials":{"postgres":{"id":"LOCAL_POSTGRES_CREDENTIAL","name":"Local Support Postgres"}}},{"parameters":{"respondWith":"json","responseBody":"={{ {status:'recorded',action:$('Validate Human Decision').item.json.action} }}"},"id":"response","name":"Approval Response","type":"n8n-nodes-base.respondToWebhook","typeVersion":1.4,"position":[360,0]}],"connections":{"Approval Webhook":{"main":[[{"node":"Validate Human Decision","type":"main","index":0}]]},"Validate Human Decision":{"main":[[{"node":"Record Approval & Queue","type":"main","index":0}]]},"Record Approval & Queue":{"main":[[{"node":"Approval Response","type":"main","index":0}]]}},"settings":{"executionOrder":"v1"},"active":false,"tags":[]}
