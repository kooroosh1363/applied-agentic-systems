{"name":"03 - Reminder Confirmation and Retry","nodes":[{"parameters":{"rule":{"interval":[{"field":"minutes","minutesInterval":1}]}},"id":"timer","name":"Every Minute","type":"n8n-nodes-base.scheduleTrigger","typeVersion":1.2,"position":[-400,0]},{"parameters":{"operation":"executeQuery","query":"SELECT n.*,a.customer_id AS destination FROM notification_attempts n JOIN appointments a ON a.id=n.appointment_id WHERE n.status='pending' AND n.due_at<=now() AND a.consent_to_reminders=true ORDER BY n.due_at FOR UPDATE SKIP LOCKED LIMIT 25;"},"id":"load","name":"Load Consented Due Reminders","type":"n8n-nodes-base.postgres","typeVersion":2.5,"position":[-160,0],"credentials":{"postgres":{"id":"LOCAL_POSTGRES_CREDENTIAL","name":"Local Appointments Postgres"}}},{"parameters":{"method":"POST","url":"={{$env.APPOINTMENT_ENGINE_URL + '/v1/deliver'}}","sendBody":true,"contentType":"raw","rawContentType":"application/json","body":"={{JSON.stringify({idempotencyKey:$json.id+':'+$json.attempt_number,destination:$json.destination,attempt:$json.attempt_number})}}","options":{"response":{"response":{"neverError":true,"fullResponse":true}}}},"id":"deliver","name":"Deliver Reminder","type":"n8n-nodes-base.httpRequest","typeVersion":4.2,"position":[80,0]},{"parameters":{"jsCode":"const o=$('Load Consented Due Reminders').item.json,s=$json.statusCode??500;const outcome=s>=200&&s<300?'delivered':(s===429||s>=500)?(o.attempt_number>=3?'dlq':'retry'):'dlq';return[{json:{...o,outcome,statusCode:s,nextAttempt:o.attempt_number+1,backoff:Math.min(300,2**o.attempt_number)}}];"},"id":"classify","name":"Bounded Delivery Policy","type":"n8n-nodes-base.code","typeVersion":2,"position":[320,0]},{"parameters":{"operation":"executeQuery","query":"UPDATE notification_attempts SET status=$1,error_code=$2 WHERE id=$3; INSERT INTO notification_attempts(appointment_id,kind,due_at,attempt_number,status,provider,next_retry_at) SELECT $4,$5,now()+make_interval(secs=>$6),$7,'pending','local-mock',now()+make_interval(secs=>$6) WHERE $1='retry' ON CONFLICT DO NOTHING; INSERT INTO dead_letter_events(entity_type,entity_id,reason,payload) SELECT 'notification',$3,'delivery_exhausted',jsonb_build_object('status',$2) WHERE $1='dlq';","options":{"queryReplacement":"={{[$json.outcome,String($json.statusCode),$json.id,$json.appointment_id,$json.kind,$json.backoff,$json.nextAttempt]}}"}},"id":"persist","name":"Persist Reminder Retry or DLQ","type":"n8n-nodes-base.postgres","typeVersion":2.5,"position":[560,0],"credentials":{"postgres":{"id":"LOCAL_POSTGRES_CREDENTIAL","name":"Local Appointments Postgres"}}}],"connections":{"Every Minute":{"main":[[{"node":"Load Consented Due Reminders","type":"main","index":0}]]},"Load Consented Due Reminders":{"main":[[{"node":"Deliver Reminder","type":"main","index":0}]]},"Deliver Reminder":{"main":[[{"node":"Bounded Delivery Policy","type":"main","index":0}]]},"Bounded Delivery Policy":{"main":[[{"node":"Persist Reminder Retry or DLQ","type":"main","index":0}]]}},"settings":{"executionOrder":"v1"},"active":false,"tags":[]}
