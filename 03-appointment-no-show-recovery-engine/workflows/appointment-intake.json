{"name":"03 - Appointment Intake and Calendar Lock","nodes":[{"parameters":{"httpMethod":"POST","path":"appointment-intake","responseMode":"responseNode"},"id":"webhook","name":"Appointment Webhook","type":"n8n-nodes-base.webhook","typeVersion":2,"position":[-600,0]},{"parameters":{"jsCode":"const crypto=require('crypto');const i=$json,b=i.body??i;if(String(i.headers?.['x-webhook-secret']??'')!==$env.APPOINTMENT_WEBHOOK_SECRET)throw new Error('unauthorized');for(const k of['sourceEventId','channel','customerId','resourceId','serviceType','startsAt','durationMinutes'])if(b[k]===undefined||b[k]==='')throw new Error(`missing ${k}`);const idempotencyKey=crypto.createHash('sha256').update(`${String(b.channel).toLowerCase()}:${b.sourceEventId}`).digest('hex');return[{json:{...b,idempotencyKey}}];"},"id":"normalize","name":"Authenticate Normalize and Identify","type":"n8n-nodes-base.code","typeVersion":2,"position":[-380,0]},{"parameters":{"operation":"executeQuery","query":"WITH e AS (INSERT INTO appointment_events(idempotency_key,source_event_id,channel,payload) VALUES($1,$2,$3,$4::jsonb) ON CONFLICT(idempotency_key) DO NOTHING RETURNING id) SELECT EXISTS(SELECT 1 FROM e) AS is_new;","options":{"queryReplacement":"={{[$json.idempotencyKey,$json.sourceEventId,$json.channel,JSON.stringify($json)]}}"}},"id":"event","name":"Persist Idempotency Event","type":"n8n-nodes-base.postgres","typeVersion":2.5,"position":[-160,0],"credentials":{"postgres":{"id":"LOCAL_POSTGRES_CREDENTIAL","name":"Local Appointments Postgres"}}},{"parameters":{"conditions":{"conditions":[{"leftValue":"={{$json.is_new}}","rightValue":true,"operator":{"type":"boolean","operation":"true","singleValue":true}}]}},"id":"new","name":"Is New Event","type":"n8n-nodes-base.if","typeVersion":2,"position":[60,0]},{"parameters":{"method":"POST","url":"={{$env.APPOINTMENT_ENGINE_URL + '/v1/plan'}}","sendBody":true,"contentType":"raw","rawContentType":"application/json","body":"={{JSON.stringify($('Authenticate Normalize and Identify').item.json)}}"},"id":"plan","name":"Plan Appointment","type":"n8n-nodes-base.httpRequest","typeVersion":4.2,"position":[280,-100]},{"parameters":{"operation":"executeQuery","query":"INSERT INTO appointments(idempotency_key,customer_id,resource_id,service_type,starts_at,ends_at,timezone,estimated_value,status,hold_expires_at,consent_to_reminders) SELECT $1,$2,$3,$4,$5::timestamptz,$5::timestamptz+make_interval(mins=>$6),$7,$8,'held',$9::timestamptz,$10 WHERE $11='hold_slot' ON CONFLICT(idempotency_key) DO UPDATE SET updated_at=now() RETURNING id; /* database constraint no_active_overlap protects calendar */ INSERT INTO waitlist_entries(customer_id,resource_id,service_type,preferred_start,status) SELECT $2,$3,$4,$5::timestamptz,'waiting' WHERE $11='waitlist';","options":{"queryReplacement":"={{[$json.idempotencyKey,$json.appointment.customerId,$json.appointment.resourceId,$json.appointment.serviceType,$json.appointment.startsAt,$json.appointment.durationMinutes,$json.appointment.timezone,$json.appointment.estimatedValue,$json.holdExpiresAt,$json.appointment.consentToReminders,$json.decision.route]}}"}},"id":"persist","name":"Persist Hold or Waitlist","type":"n8n-nodes-base.postgres","typeVersion":2.5,"position":[500,-100],"credentials":{"postgres":{"id":"LOCAL_POSTGRES_CREDENTIAL","name":"Local Appointments Postgres"}}},{"parameters":{"respondWith":"json","responseBody":"={{ {status:'accepted',evidence:'simulated'} }}","options":{"responseCode":202}},"id":"accepted","name":"Accepted","type":"n8n-nodes-base.respondToWebhook","typeVersion":1.4,"position":[720,-100]},{"parameters":{"respondWith":"json","responseBody":"={{ {status:'duplicate'} }}"},"id":"duplicate","name":"Duplicate","type":"n8n-nodes-base.respondToWebhook","typeVersion":1.4,"position":[280,120]}],"connections":{"Appointment Webhook":{"main":[[{"node":"Authenticate Normalize and Identify","type":"main","index":0}]]},"Authenticate Normalize and Identify":{"main":[[{"node":"Persist Idempo