{
  "name": "P11 Stored Release Decision",
  "nodes": [
    {
      "parameters": {},
      "id": "trigger",
      "name": "Execute Workflow Trigger",
      "type": "n8n-nodes-base.executeWorkflowTrigger",
      "typeVersion": 1,
      "position": [0, 0]
    },
    {
      "parameters": {
        "jsCode": "if(!/^[a-f0-9-]{36}$/.test($json.runId||''))throw new Error('runId required');return [{json:{runId:$json.runId}}];"
      },
      "id": "Validate Run ID",
      "name": "Validate Run ID",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [260, 0]
    },
    {
      "parameters": {
        "method": "GET",
        "url": "={{ ($env.EVALUATOR_URL || 'http://127.0.0.1:8110') + '/api/runs/' + $json.runId }}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "={{ \"Bearer \" + $env.P11_API_TOKEN }}"
            }
          ]
        },
        "options": {
          "timeout": 300000
        }
      },
      "id": "request",
      "name": "Workbench API",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [520, 0]
    },
    {
      "parameters": {
        "jsCode": "if(!$json.regression||!$json.summary||$json.humanApprovalRequired!==true)throw new Error('No complete release assessment');const allowed=$json.summary.passed&&$json.regression.passed&&$json.releaseDecision==='eligible_for_human_review';return [{json:{runId:$json.runId,releaseDecision:allowed?'eligible_for_human_review':'blocked',humanApprovalRequired:true,autoPromote:false}}];"
      },
      "id": "Fail Closed Decision",
      "name": "Fail Closed Decision",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [780, 0]
    }
  ],
  "connections": {
    "Execute Workflow Trigger": {
      "main": [
        [
          {
            "node": "Validate Run ID",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Validate Run ID": {
      "main": [
        [
          {
            "node": "Workbench API",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Workbench API": {
      "main": [
        [
          {
            "node": "Fail Closed Decision",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "active": false,
  "settings": {
    "executionOrder": "v1"
  }
}
