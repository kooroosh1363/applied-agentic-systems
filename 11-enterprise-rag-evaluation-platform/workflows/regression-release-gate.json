{"name":"P11 Regression and Release Gate","nodes":[{"parameters":{},"id":"1","name":"Execute Workflow Trigger","type":"n8n-nodes-base.executeWorkflowTrigger","typeVersion":1,"position":[0,0]},{"parameters":{"jsCode":"const tolerance=Number($json.tolerance??0.02); const regressions=[]; for(const [metric,base] of Object.entries($json.baseline||{})){const current=Number(($json.current||{})[metric]??0); if(current-Number(base)<-tolerance) regressions.push({metric,baseline:base,current});} return [{json:{...$json,regressions}}];"},"id":"2","name":"Compare Baseline","type":"n8n-nodes-base.code","typeVersion":2,"position":[240,0]},{"parameters":{"jsCode":"return [{json:{...$json,releaseDecision:$json.regressions.length?'block':'review_for_promotion',humanApprovalRequired:true}}];"},"id":"3","name":"Create Release Decision","type":"n8n-nodes-base.code","typeVersion":2,"position":[480,0]}],"connections":{"Execute Workflow Trigger":{"main":[[{"node":"Compare Baseline","type":"main","index":0}]]},"Compare Baseline":{"main":[[{"node":"Create Release Decision","type":"main","index":0}]]}},"active":false,"settings":{"executionOrder":"v1"},"versionId":"33333333-3333-4333-8333-333333333333"}
