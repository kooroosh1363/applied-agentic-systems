{
  "name": "P11 Stored Evidence Report",
  "nodes": [
    {
      "parameters": {},
      "id": "trigger",
      "name": "Execute Workflow Trigger",
      "type": "n8n-nodes-base.executeWorkflowTrigger",
      "typeVersion": 1,
      "position": [0, 0]
    },
    {
      "parameters": {
        "jsCode": "if(!/^[a-f0-9-]{36}$/.test($json.runId||''))throw new Error('runId required');return [{json:{runId:$json.runId}}];"
      },
      "id": "Validate Report ID",
      "name": "Validate Report ID",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [260, 0]
    },
    {
      "parameters": {
        "method": "GET",
        "url": "={{ ($env.EVALUATOR_URL || 'http://127.0.0.1:8110') + '/api/runs/' + $json.runId }}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "={{ \"Bearer \" + $env.P11_API_TOKEN }}"
            }
          ]
        },
        "options": {
          "timeout": 300000
        }
      },
      "id": "request",
      "name": "Workbench API",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [520, 0]
    },
    {
      "parameters": {
        "jsCode": "if(!$json.results||!$json.datasetHash)throw new Error('Missing report evidence');return [{json:{runId:$json.runId,datasetHash:$json.datasetHash,policyHash:$json.policyHash,summary:$json.summary,regression:$json.regression,evidence:$json.evidence,notices:$json.notices}}];"
      },
      "id": "Report Actual Metrics",
      "name": "Report Actual Metrics",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [780, 0]
    }
  ],
  "connections": {
    "Execute Workflow Trigger": {
      "main": [
        [
          {
            "node": "Validate Report ID",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Validate Report ID": {
      "main": [
        [
          {
            "node": "Workbench API",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Workbench API": {
      "main": [
        [
          {
            "node": "Report Actual Metrics",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "active": false,
  "settings": {
    "executionOrder": "v1"
  }
}
