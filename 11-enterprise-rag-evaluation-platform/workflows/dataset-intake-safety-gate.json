{
  "name": "P11 Server Dataset Inspection",
  "nodes": [
    {
      "parameters": {},
      "id": "trigger",
      "name": "Execute Workflow Trigger",
      "type": "n8n-nodes-base.executeWorkflowTrigger",
      "typeVersion": 1,
      "position": [0, 0]
    },
    {
      "parameters": {
        "method": "GET",
        "url": "={{ ($env.EVALUATOR_URL || 'http://127.0.0.1:8110') + '/api/bootstrap' }}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "={{ \"Bearer \" + $env.P11_API_TOKEN }}"
            }
          ]
        },
        "options": {
          "timeout": 300000
        }
      },
      "id": "request",
      "name": "Workbench API",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [260, 0]
    },
    {
      "parameters": {
        "jsCode": "const d=$json.dataset;if(!d||d.provenance!=='synthetic')throw new Error('Unexpected dataset');return [{json:{datasetId:d.datasetId,version:d.version,caseCount:d.cases.length,reviewStatus:d.reviewStatus}}];"
      },
      "id": "Dataset Summary",
      "name": "Dataset Summary",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [520, 0]
    }
  ],
  "connections": {
    "Execute Workflow Trigger": {
      "main": [
        [
          {
            "node": "Workbench API",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Workbench API": {
      "main": [
        [
          {
            "node": "Dataset Summary",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "active": false,
  "settings": {
    "executionOrder": "v1"
  }
