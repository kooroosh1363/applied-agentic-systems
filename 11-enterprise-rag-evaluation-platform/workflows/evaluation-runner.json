{
  "name": "P11 Shared Evaluation Runner",
  "nodes": [
    {
      "parameters": {},
      "id": "trigger",
      "name": "Execute Workflow Trigger",
      "type": "n8n-nodes-base.executeWorkflowTrigger",
      "typeVersion": 1,
      "position": [0, 0]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ ($env.EVALUATOR_URL || 'http://127.0.0.1:8110') + '/api/evaluate' }}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "={{ \"Bearer \" + $env.P11_API_TOKEN }}"
            }
          ]
        },
        "options": {
          "timeout": 300000
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ {config:$json.config || {}} }}"
      },
      "id": "request",
      "name": "Workbench API",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [260, 0]
    },
    {
      "parameters": {
        "jsCode": "const r=$json.candidate;if(!r||!r.regression||!r.summary||!['blocked','eligible_for_human_review'].includes(r.releaseDecision))throw new Error('Incomplete evaluation response');return [{json:r}];"
      },
      "id": "Read Shared Decision",
      "name": "Read Shared Decision",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [520, 0]
    }
  ],
  "connections": {
    "Execute Workflow Trigger": {
      "main": [
        [
          {
            "node": "Workbench API",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Workbench API": {
      "main": [
        [
          {
            "node": "Read Shared Decision",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "active": false,
  "settings": {
    "executionOrder": "v1"
  }
}
