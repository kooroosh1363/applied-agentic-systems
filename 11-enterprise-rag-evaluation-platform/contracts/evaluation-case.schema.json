{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Project 11 server-owned evaluation case v2",
  "type": "object",
  "required": [
    "caseId",
    "question",
    "language",
    "tags",
    "allowedScopes",
    "relevantDocumentIds",
    "expectedFactIds",
    "expectedOutcome"
  ],
  "properties": {
    "caseId": { "type": "string", "minLength": 1 },
    "question": { "type": "string", "minLength": 1 },
    "language": { "type": "string", "minLength": 1 },
    "tags": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "allowedScopes": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "relevantDocumentIds": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "expectedFactIds": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "expectedOutcome": { "enum": ["answer", "abstain", "review", "block"] }
  },
  "additionalProperties": false,
  "$comment": "Runtime validators additionally enforce corpus membership, authorization, gold fact existence and answerability requirements. Dataset uploads are not accepted by HTTP."
}
