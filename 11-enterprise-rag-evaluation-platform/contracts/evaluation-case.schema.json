{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://example.local/schemas/rag-evaluation-case-v1.json",
  "title":"RAG evaluation case",
  "type":"object",
  "required":["caseId","question","relevantDocumentIds","expectedFactIds"],
  "properties":{
    "caseId":{"type":"string","minLength":1},
    "question":{"type":"string","minLength":3},
    "relevantDocumentIds":{"type":"array","minItems":1,"uniqueItems":true,"items":{"type":"string","minLength":1}},
    "expectedFactIds":{"type":"array","minItems":1,"uniqueItems":true,"items":{"type":"string","minLength":1}},
    "tags":{"type":"array","uniqueItems":true,"items":{"type":"string"}}
  },
  "additionalProperties":false
}
