PORT=8110
P11_BIND=127.0.0.1
# Node does not read this automatically: node --env-file=.env src/server.mjs
# Optional local models, already downloaded by the operator:
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_EMBED_MODEL=
OLLAMA_MODEL=
OLLAMA_JUDGE_MODEL=
# Optional API token for n8n; otherwise browser sessions use an ephemeral token:
P11_API_TOKEN=
# Default storage: local atomic JSON files. Optional PostgreSQL for Node host mode:
DATABASE_URL=
POSTGRES_DB=rag_eval
POSTGRES_USER=rag_eval
POSTGRES_PASSWORD=local-only-change-me
