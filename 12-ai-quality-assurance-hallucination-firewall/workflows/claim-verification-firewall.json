{"name":"12.2 Claim Verification Firewall","active":false,"settings":{"executionOrder":"v1"},"nodes":[{"id":"manual","name":"Manual Trigger","type":"n8n-nodes-base.manualTrigger","typeVersion":1,"position":[0,0],"parameters":{}},{"id":"claims","name":"Decompose Claims","type":"n8n-nodes-base.code","typeVersion":2,"position":[240,0],"parameters":{"jsCode":"return ($json.candidate?.claims||[]).map(claim=>({json:{request:$json.request,evidence:$json.evidence,claim}}));"}},{"id":"verify","name":"Verify Citation Scope Freshness","type":"n8n-nodes-base.code","typeVersion":2,"position":[480,0],"parameters":{"jsCode":"const sources=new Map(($json.evidence||[]).map(s=>[s.sourceId,s]));const cited=($json.claim.citationIds||[]).map(id=>sources.get(id));return [{json:{...$json,verified:cited.length>0&&cited.every(Boolean),evidenceBoundary:'simulated'}}];"}},{"id":"decision","name":"Policy Decision","type":"n8n-nodes-base.code","typeVersion":2,"position":[720,0],"parameters":{"jsCode":"return [{json:{...$json,decision:$json.verified?'allow':'review'}}];"}}],"connections":{"Manual Trigger":{"main":[[{"node":"Decompose Claims","type":"main","index":0}]]},"Decompose Claims":{"main":[[{"node":"Verify Citation Scope Freshness","type":"main","index":0}]]},"Verify Citation Scope Freshness":{"main":[[{"node":"Policy Decision","type":"main","index":0}]]}}}
