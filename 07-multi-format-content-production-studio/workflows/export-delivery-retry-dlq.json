{
  "name": "07.6 Export Delivery Retry and DLQ",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "minutes",
              "minutesInterval": 5
            }
          ]
        }
      },
      "id": "schedule",
      "name": "Retry Schedule",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        0,
        0
      ]
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT * FROM delivery_attempts WHERE status='retry' AND next_retry_at<=now() ORDER BY next_retry_at LIMIT 100"
      },
      "id": "load",
      "name": "Load Due Export Retry Batch",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.6,
      "position": [
        220,
        0
      ],
      "credentials": {
        "postgres": {
          "id": "REPLACE_ME",
          "name": "Local Studio Postgres"
        }
      }
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.STUDIO_ENGINE_URL }}/v1/deliver",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ {attempt:$json.attempt_number,simulate:$json.simulate} }}",
        "options": {
          "response": {
            "response": {
              "neverError": true,
              "responseFormat": "json"
            }
          }
        }
      },
      "id": "deliver",
      "name": "Attempt Local Export Delivery",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        440,
        0
      ]
    },
    {
      "parameters": {
        "jsCode": "const outcome=$json.outcome; return [{json:{...$json,outcome,nextRetryAt:outcome==='retry'?new Date(Date.now()+300000*Math.pow(2,Math.max(0,($json.attempt_number??1)-1))).toISOString():null}}];"
      },
      "id": "classify",
      "name": "Classify Bounded Retry or DLQ",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        660,
        0
      ]
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "UPDATE delivery_attempts SET status=$1,next_retry_at=$2 WHERE id=$3; INSERT INTO dead_letter_events(entity_type,entity_id,reason,payload) SELECT 'export-manifest',$4,'delivery_retry_exhausted',$5::jsonb WHERE $1='dlq'; INSERT INTO audit_log(entity_type,actor,action,details) VALUES('export-delivery','retry-worker',$1,$5::jsonb)",
        "options": {
          "queryReplacement": "={{ [$json.outcome,$json.nextRetryAt,$('Load Due Export Retry Batch').item.json.id,$('Load Due Export Retry Batch').item.json.export_manifest_id,JSON.stringify({attempt:$('Load Due Export Retry Batch').item.json.attempt_number,nextRetryAt:$json.nextRetryAt})] }}"
        }
      },
      "id": "persist",
      "name": "Persist Retry DLQ Evidence",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.6,
      "position": [
        880,
        0
      ],
      "credentials": {
        "postgres": {
          "id": "REPLACE_ME",
          "name": "Local Studio Postgres"
        }
      }
    }
  ],
  "connections": {
    "Retry Schedule": {
      "main": [
        [
          {
            "node": "Load Due Export Retry Batch",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Load Due Export Retry Batch": {
      "main": [
        [
          {
            "node": "Attempt Local Export Delivery",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Attempt Local Export Delivery": {
      "main": [
        [
          {
            "node": "Classify Bounded Retry or DLQ",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Classify Bounded Retry or DLQ": {
      "main": [
        [
          {
            "node": "Persist Retry DLQ Evidence",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1",
    "saveDataErrorExecution": "all"
  },
  "active": false,
  "tags": []
}
