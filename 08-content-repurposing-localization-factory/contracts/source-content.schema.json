{
  "$schema":"https://json-schema.org/draft/2020-12/schema","$id":"https://example.local/contracts/source-content.schema.json","title":"Versioned source content","type":"object","additionalProperties":false,
  "required":["schemaVersion","sourceEventId","contentId","version","sourceLocale","title","segments","targetLocales","formats","brandVersion"],
  "properties":{
    "schemaVersion":{"const":"1.0"},"sourceEventId":{"type":"string","minLength":1,"maxLength":120},"contentId":{"type":"string","minLength":1,"maxLength":120},"version":{"type":"integer","minimum":1},
    "sourceLocale":{"enum":["en-US","fa-IR","es-ES"]},"title":{"type":"string","minLength":1,"maxLength":200},"brandVersion":{"type":"integer","minimum":1},
    "targetLocales":{"type":"array","minItems":1,"uniqueItems":true,"items":{"enum":["en-US","fa-IR","es-ES"]}},
    "formats":{"type":"array","minItems":1,"uniqueItems":true,"items":{"enum":["localized_article","social_post","email","subtitles_srt","carousel_copy"]}},
    "segments":{"type":"array","minItems":1,"maxItems":100,"items":{"type":"object","additionalProperties":false,"required":["segmentId","text","kind"],"properties":{"segmentId":{"type":"string","minLength":1,"maxLength":80},"text":{"type":"string","minLength":1,"maxLength":3000},"kind":{"enum":["headline","body","cta","caption"]},"claimId":{"type":"string","maxLength":80},"startMs":{"type":"integer","minimum":0},"endMs":{"type":"integer","minimum":1}}}},
    "evidenceBoundary":{"enum":["simulated","source_verified"]},"requestedBy":{"type":"string","maxLength":120}
  }
}
