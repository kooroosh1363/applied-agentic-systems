{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.local/contracts/lead-event.schema.json",
  "title": "Omnichannel Lead Event",
  "type": "object",
  "additionalProperties": false,
  "required": ["sourceEventId", "channel", "message", "consentToContact"],
  "anyOf": [{ "required": ["email"] }, { "required": ["phone"] }],
  "properties": {
    "sourceEventId": { "type": "string", "minLength": 1, "maxLength": 200 },
    "channel": { "enum": ["web", "email", "instagram", "whatsapp", "phone"] },
    "name": { "type": "string", "maxLength": 200 },
    "email": { "type": "string", "format": "email", "maxLength": 320 },
    "phone": { "type": "string", "minLength": 5, "maxLength": 30 },
    "message": { "type": "string", "minLength": 1, "maxLength": 5000 },
    "consentToContact": { "type": "boolean" },
    "serviceType": { "type": "string", "maxLength": 100 },
    "estimatedValue": { "type": "number", "minimum": 0 },
    "urgency": { "enum": ["low", "normal", "high", "emergency"] },
    "receivedAt": { "type": "string", "format": "date-time" },
    "metadata": { "type": "object", "additionalProperties": { "type": ["string", "number", "boolean"] } }
  }
}

