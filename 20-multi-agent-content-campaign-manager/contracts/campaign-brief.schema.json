{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://example.local/contracts/campaign-brief.schema.json",
  "title":"Multi-Agent Campaign Brief",
  "type":"object",
  "required":["campaignId","version","name","goal","ownerId","audience","locale","currency","budgetMinor","startsAt","endsAt","brandPolicyVersion","channels","kpis","sourceAssets"],
  "properties":{
    "campaignId":{"type":"string","minLength":1},
    "version":{"type":"string","minLength":1},
    "currency":{"enum":["CAD","USD","EUR","GBP"]},
    "budgetMinor":{"type":"integer","minimum":1},
    "channels":{"type":"array","minItems":1,"uniqueItems":true,"items":{"enum":["linkedin","x","instagram","email"]}},
    "sourceAssets":{"type":"array","minItems":1},
    "evidenceBoundary":{"enum":["simulated","provider_verified"]}
  },
  "additionalProperties":true
}
